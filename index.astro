‎---
‎// Import the countdown component
‎import NextServiceCountdown from "../components/NextServiceCountdown.astro";
‎---
‎
‎<html lang="en">
‎  <head>
‎    <meta charset="UTF-8" />
‎    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
‎    <title>Rehoboth Baptist Church</title>
‎
‎    <!-- Optional: only needed if you use any Font Awesome icons elsewhere -->
‎    <link
‎      rel="stylesheet"
‎      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
‎    />
‎
‎    <!-- Global CSS variables used by the countdown -->
‎    <style is:global>
‎      :root {
‎        --church-red: #9E1519;
‎        --church-red-dark: #741014;
‎        --white: #ffffff;
‎        --cream: #fbf8f4;
‎        --text: #292525;
‎        --muted: #6b6562;
‎        --border: #e8dfd9;
‎        --soft-red: #f8eaea;
‎      }
‎
‎      body {
‎        margin: 0;
‎        font-family: Arial, Helvetica, sans-serif;
‎        line-height: 1.7;
‎        color: var(--text);
‎        background: var(--white);
‎      }
‎    </style>
‎  </head>
‎
‎  <body>
‎    <!-- This renders the countdown component -->
‎    <NextServiceCountdown />
‎
‎    <!-- The rest of your page goes here -->
‎    <main>
‎      <h1>Welcome to Rehoboth Baptist Church</h1>
‎      <p>House of Testimonies · Kweiman, Accra</p>
‎    </main>
‎  </body>
‎</html>
‎
