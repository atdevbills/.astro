‎---
‎// ---------- Next service countdown (Ghana time = GMT/UTC, no daylight saving) ----------
‎// day: 0 = Sunday ... 6 = Saturday. Times are 24-hour, in Ghana time.
‎const services = [
‎  { day: 0, name: "Bible Study",                        start: "08:00", end: "09:00" },
‎  { day: 0, name: "Worship Service",                    start: "09:00", end: "12:00" },
‎  { day: 3, name: "Teaching Service",                   start: "18:30", end: "20:00" },
‎  { day: 5, name: "Prayer Service",                     start: "18:30", end: "20:00" },
‎  { day: 6, name: "Evangelism, Visitation & Follow up", start: "15:00", end: "18:00" }
‎];
‎---
‎
‎<!-- NEXT SERVICE COUNTDOWN -->
‎<section class="next-service" id="next-service" aria-label="Next church service">
‎  <div class="next-inner">
‎    <div class="next-info">
‎      <p class="next-label" id="next-label">
‎        <span class="live-dot" id="live-dot" aria-hidden="true"></span>
‎        <span id="next-status">NEXT SERVICE</span>
‎      </p>
‎      <p class="next-name" id="next-name">Loading...</p>
‎      <p class="next-when" id="next-when"></p>
‎    </div>
‎
‎    <div class="countdown" id="countdown" role="timer" aria-live="off">
‎      <div class="count-box"><span class="count-num" id="cd-days">00</span><span class="count-unit">Days</span></div>
‎      <div class="count-box"><span class="count-num" id="cd-hours">00</span><span class="count-unit">Hrs</span></div>
‎      <div class="count-box"><span class="count-num" id="cd-mins">00</span><span class="count-unit">Min</span></div>
‎      <div class="count-box"><span class="count-num" id="cd-secs">00</span><span class="count-unit">Sec</span></div>
‎    </div>
‎  </div>
‎</section>
‎
‎<style>
‎  /* NEXT SERVICE COUNTDOWN */
‎
‎  .next-service {
‎    padding: 18px clamp(16px, 5vw, 64px);
‎    color: var(--text, #292525);
‎    background: #ffffff;
‎    border-bottom: 1px solid var(--border, #e8dfd9);
‎  }
‎
‎  .next-inner {
‎    display: flex;
‎    align-items: center;
‎    justify-content: space-between;
‎    flex-wrap: wrap;
‎    gap: 16px 28px;
‎    width: min(1100px, 100%);
‎    margin: 0 auto;
‎  }
‎
‎  .next-info {
‎    flex: 1 1 240px;
‎    min-width: 0;
‎  }
‎
‎  .next-label {
‎    display: flex;
‎    align-items: center;
‎    gap: 8px;
‎    margin: 0;
‎    color: var(--church-red, #9E1519);
‎    font-size: 12px;
‎    font-weight: 700;
‎    letter-spacing: 2px;
‎  }
‎
‎  .live-dot {
‎    display: none;
‎    width: 10px;
‎    height: 10px;
‎    border-radius: 50%;
‎    background: #ff5a5f;
‎    box-shadow: 0 0 0 0 rgba(255, 90, 95, 0.7);
‎    animation: livePulse 1.6s infinite;
‎  }
‎
‎  .next-service.is-live .live-dot {
‎    display: inline-block;
‎  }
‎
‎  .next-service.is-live .next-label {
‎    color: var(--church-red-dark, #741014);
‎  }
‎
‎  @keyframes livePulse {
‎    0% { box-shadow: 0 0 0 0 rgba(255, 90, 95, 0.7); }
‎    70% { box-shadow: 0 0 0 10px rgba(255, 90, 95, 0); }
‎    100% { box-shadow: 0 0 0 0 rgba(255, 90, 95, 0); }
‎  }
‎
‎  .next-name {
‎    margin: 2px 0 0;
‎    font-size: clamp(19px, 3vw, 26px);
‎    font-weight: 700;
‎    line-height: 1.25;
‎    color: var(--text, #292525);
‎  }
‎
‎  .next-when {
‎    margin: 2px 0 0;
‎    color: var(--muted, #6b6562);
‎    font-size: 14px;
‎  }
‎
‎  .countdown {
‎    display: flex;
‎    gap: 10px;
‎  }
‎
‎  .next-service.is-live .countdown {
‎    display: none;
‎  }
‎
‎  .count-box {
‎    display: flex;
‎    flex-direction: column;
‎    align-items: center;
‎    min-width: 64px;
‎    padding: 8px 6px;
‎    background: var(--soft-red, #f8eaea);
‎    border: 1px solid var(--border, #e8dfd9);
‎    border-radius: 10px;
‎  }
‎
‎  .count-num {
‎    font-size: clamp(22px, 4vw, 30px);
‎    font-weight: 700;
‎    line-height: 1.1;
‎    color: var(--church-red, #9E1519);
‎    font-variant-numeric: tabular-nums;
‎  }
‎
‎  .count-unit {
‎    font-size: 10px;
‎    letter-spacing: 1.5px;
‎    text-transform: uppercase;
‎    color: var(--muted, #6b6562);
‎  }
‎
‎  @media (max-width: 760px) {
‎    .next-service {
‎      padding: 10px 14px;
‎    }
‎
‎    .next-inner {
‎      flex-direction: column;
‎      align-items: stretch;
‎      gap: 8px;
‎      text-align: center;
‎    }
‎
‎    .next-info {
‎      flex: none;
‎    }
‎
‎    .next-label {
‎      justify-content: center;
‎      font-size: 10px;
‎      letter-spacing: 1.5px;
‎    }
‎
‎    .next-name {
‎      margin: 0;
‎      font-size: 16px;
‎      line-height: 1.2;
‎    }
‎
‎    .next-when {
‎      margin: 1px 0 0;
‎      font-size: 12px;
‎      line-height: 1.3;
‎    }
‎
‎    .countdown {
‎      justify-content: center;
‎      gap: 6px;
‎    }
‎
‎    .count-box {
‎      flex: 1 1 0;
‎      min-width: 0;
‎      max-width: 68px;
‎      padding: 4px 2px;
‎      border-radius: 8px;
‎    }
‎
‎    .count-num {
‎      font-size: 18px;
‎    }
‎
‎    .count-unit {
‎      font-size: 8px;
‎      letter-spacing: 1px;
‎    }
‎  }
‎</style>
‎
‎<script>
‎  // ---------- Next service countdown (Ghana time = GMT/UTC, no daylight saving) ----------
‎  // day: 0 = Sunday ... 6 = Saturday. Times are 24-hour, in Ghana time.
‎  const SERVICES = [
‎    { day: 0, name: "Bible Study",                        start: "08:00", end: "09:00" },
‎    { day: 0, name: "Worship Service",                    start: "09:00", end: "12:00" },
‎    { day: 3, name: "Teaching Service",                   start: "18:30", end: "20:00" },
‎    { day: 5, name: "Prayer Service",                     start: "18:30", end: "20:00" },
‎    { day: 6, name: "Evangelism, Visitation & Follow up", start: "15:00", end: "18:00" }
‎  ];
‎
‎  const DAY_NAMES = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
‎  const MINUTE = 60 * 1000;
‎  const DAY = 24 * 60 * MINUTE;
‎
‎  const nextService = document.getElementById("next-service") as HTMLElement | null;
‎  const nextStatus = document.getElementById("next-status");
‎  const nextName = document.getElementById("next-name");
‎  const nextWhen = document.getElementById("next-when");
‎  const cdDays = document.getElementById("cd-days");
‎  const cdHours = document.getElementById("cd-hours");
‎  const cdMins = document.getElementById("cd-mins");
‎  const cdSecs = document.getElementById("cd-secs");
‎
‎  function toMinutes(time: string): number {
‎    const parts = time.split(":");
‎    return Number(parts[0]) * 60 + Number(parts[1]);
‎  }
‎
‎  function formatTime(time: string): string {
‎    const mins = toMinutes(time);
‎    const h24 = Math.floor(mins / 60);
‎    const m = mins % 60;
‎    const suffix = h24 >= 12 ? "PM" : "AM";
‎    const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
‎    return h12 + ":" + String(m).padStart(2, "0") + " " + suffix;
‎  }
‎
‎  // Finds the service happening now, or the soonest upcoming one.
‎  function findService(nowMs: number) {
‎    const todayUtc = new Date(nowMs);
‎    const midnight = Date.UTC(
‎      todayUtc.getUTCFullYear(),
‎      todayUtc.getUTCMonth(),
‎      todayUtc.getUTCDate()
‎    );
‎
‎    let upcoming: { service: typeof SERVICES[number]; start: number; end: number; live: boolean } | null = null;
‎
‎    for (let offset = 0; offset <= 7; offset++) {
‎      const dayStart = midnight + offset * DAY;
‎      const weekday = new Date(dayStart).getUTCDay();
‎
‎      for (const service of SERVICES) {
‎        if (service.day !== weekday) continue;
‎
‎        const start = dayStart + toMinutes(service.start) * MINUTE;
‎        const end = dayStart + toMinutes(service.end) * MINUTE;
‎
‎        if (nowMs >= start && nowMs < end) {
‎          return { service, start, end, live: true };
‎        }
‎
‎        if (start > nowMs && (!upcoming || start < upcoming.start)) {
‎          upcoming = { service, start, end, live: false };
‎        }
‎      }
‎    }
‎
‎    return upcoming;
‎  }
‎
‎  function pad(number: number): string {
‎    return String(number).padStart(2, "0");
‎  }
‎
‎  function updateCountdown() {
‎    const now = Date.now();
‎    const found = findService(now);
‎
‎    if (!found || !nextService) return;
‎
‎    const { service, start, end, live } = found;
‎
‎    nextService.classList.toggle("is-live", live);
‎    if (nextName) nextName.textContent = service.name;
‎
‎    if (live) {
‎      if (nextStatus) nextStatus.textContent = "HAPPENING NOW";
‎      if (nextWhen) nextWhen.textContent = "Ends at " + formatTime(service.end) + " (Ghana time)";
‎      return;
‎    }
‎
‎    if (nextStatus) nextStatus.textContent = "NEXT SERVICE";
‎    if (nextWhen) {
‎      nextWhen.textContent =
‎        DAY_NAMES[service.day] + ", " + formatTime(service.start) +
‎        " – " + formatTime(service.end) + " (Ghana time)";
‎    }
‎
‎    const remaining = Math.max(0, start - now);
‎    if (cdDays) cdDays.textContent = pad(Math.floor(remaining / DAY));
‎    if (cdHours) cdHours.textContent = pad(Math.floor((remaining % DAY) / (60 * MINUTE)));
‎    if (cdMins) cdMins.textContent = pad(Math.floor((remaining % (60 * MINUTE)) / MINUTE));
‎    if (cdSecs) cdSecs.textContent = pad(Math.floor((remaining % MINUTE) / 1000));
‎  }
‎
‎  updateCountdown();
‎  setInterval(updateCountdown, 1000);
‎</script>
‎
